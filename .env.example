# Public site URL used in canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://oracleoffreedom.com

# Inquiry email. The site builds and the form works without these.
# When they are empty, the form still validates and the thank-you page
# explains that email is not configured.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oracle of Freedom <agota@oracleoffreedom.com>
INQUIRY_TO_EMAIL=agota@oracleoffreedom.com

# Keystatic. Leave KEYSTATIC_STORAGE unset (or "local") while editing on your computer.
# On Vercel, local saves do not persist. Use GitHub mode:
# KEYSTATIC_STORAGE=github
# KEYSTATIC_GITHUB_REPO=owner/oracle-of-freedom
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
KEYSTATIC_STORAGE=local
KEYSTATIC_GITHUB_REPO=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=

# Web Push for the studio on Ágota's phone. Generate a pair once with
# `npx web-push generate-vapid-keys` and keep the same keys across deploys.
# The studio asks her to allow notifications; these keys deliver
# requests, consultations and appointments to that Android.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:agota@oracleoffreedom.com

# Password for /admin. The page stays locked until this is set.
# On Vercel, add it under Settings → Environment Variables, then redeploy.
ADMIN_PASSWORD=

# Created for you when you connect a Vercel Blob store to this project.
# That store is where live prices and promotions are saved. Leave this empty
# locally unless you intend to edit the public site from this computer.
BLOB_READ_WRITE_TOKEN=

# Google Calendar OAuth. Create a Web application in Google Cloud, enable the
# Google Calendar API, and add this callback URL to its authorised redirect URIs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://oracleoffreedom.com/api/admin/google/callback
# A long random value used to encrypt the saved Google refresh token.
# ADMIN_PASSWORD is used as a fallback, but a separate key survives password changes.
GOOGLE_TOKEN_ENCRYPTION_KEY=
